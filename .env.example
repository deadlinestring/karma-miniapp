# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database / Prisma

# Runtime connection for the deployed Next.js application.
# Supabase Transaction pooler, usually port 6543.
# `pgbouncer=true` is required for Prisma when using Supabase Transaction mode.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Migration connection for Prisma CLI.
# Supabase Session pooler, usually port 5432.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Storage — needed later for admin panel and image upload
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_CATALOG_BUCKET="catalog-images"
SUPABASE_CUSTOM_UPLOADS_BUCKET="custom-order-uploads"

# Telegram — needed later
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
ADMIN_TELEGRAM_IDS=""
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="3600"

# Payments — needed later
PAYMENT_PROVIDER="demo"
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL=""
TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
TBANK_SUCCESS_URL=""
TBANK_FAIL_URL=""
PAYMENT_WEBHOOK_SECRET=""
