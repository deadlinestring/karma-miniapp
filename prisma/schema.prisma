generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  REGULAR
  CUSTOM
}

enum ItemType {
  STANDARD
  PREMIUM
  WALL_PANEL
}

enum PaymentProvider {
  DEMO
  YOOKASSA
  TBANK
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum FulfillmentStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  IN_WORK
  MANUFACTURED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum CustomDrawingStyle {
  CUSTOM_DRAWING_STYLE_1
  CUSTOM_DRAWING_STYLE_2
  CUSTOM_DRAWING_STYLE_3
}

enum CustomImageReviewStatus {
  NOT_REQUIRED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DeliveryMethod {
  RUSSIAN_POST
}

model StoreSettings {
  id           String   @id @default("main")
  storeName    String
  subtitle     String?
  heroTitle    String
  heroSubtitle String
  logoUrl      String?
  heroImageUrl String?
  contactText  String?
  deliveryText String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FaqSection {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ContentBlock {
  id        String   @id @default(cuid())
  slug      String   @unique
  page      String?
  title     String?
  body      String?
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([page, isActive, sortOrder])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  coverImageUrl String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]

  @@index([isActive, sortOrder])
}

model Subcategory {
  id            String    @id @default(cuid())
  categoryId    String
  name          String
  slug          String
  coverImageUrl String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products      Product[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model Product {
  id            String           @id @default(cuid())
  subcategoryId String
  priceListId   String?
  externalId    String?          @unique
  name          String
  slug          String           @unique
  description   String
  productType   ProductType      @default(REGULAR)
  isFeatured    Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subcategory   Subcategory      @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  priceList     PriceList?       @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([subcategoryId, isActive])
  @@index([priceListId])
  @@index([isFeatured, isActive])
}

model PriceList {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PriceListItem[]
  products  Product[]

  @@index([isActive])
}

model PriceListItem {
  id           String    @id @default(cuid())
  priceListId  String
  itemType     ItemType
  sizeCm       Int
  priceKopecks Int
  note         String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  priceList    PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, itemType, sizeCm])
  @@index([priceListId, isActive, sortOrder])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  storagePath String?
  altText     String?
  isCover     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  itemType     ItemType
  sizeCm       Int
  priceKopecks Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, itemType, sizeCm])
  @@index([productId, isActive])
}

model TelegramUser {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  lastName   String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model DeliveryAddress {
  id          String   @id @default(cuid())
  orderId     String   @unique
  city        String
  addressLine String?
  street      String
  house       String
  apartment   String?
  postalCode  String?
  comment     String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Order {
  id                        String            @id @default(cuid())
  publicNumber              String            @unique
  userId                    String?
  customerName              String
  customerPhone             String
  customerTelegramUsername  String?
  customerTelegramId        BigInt?
  customerTelegramFirstName String?
  customerTelegramLastName  String?
  customerContact           String?
  comment                   String?
  adminNotes                String?
  itemsSubtotalKopecks      Int               @default(0)
  customDrawingKopecks      Int               @default(0)
  deliveryMethod            DeliveryMethod    @default(RUSSIAN_POST)
  deliveryKopecks           Int               @default(0)
  discountKopecks           Int               @default(0)
  totalKopecks              Int
  paymentProvider           PaymentProvider   @default(DEMO)
  paymentStatus             PaymentStatus     @default(PENDING)
  fulfillmentStatus         FulfillmentStatus @default(NEW)
  consentPersonalData       Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  user                      TelegramUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryAddress           DeliveryAddress?
  items                     OrderItem[]
  payments                  Payment[]
  notificationLogs          NotificationLog[]

  @@index([userId, createdAt])
  @@index([paymentStatus, fulfillmentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                            String                  @id @default(cuid())
  orderId                       String
  productId                     String?
  priceListItemId               String?
  productNameSnapshot           String
  productSlugSnapshot           String?
  productImageSnapshot          String?
  itemTypeSnapshot              ItemType
  itemTypeLabelSnapshot         String?
  sizeCmSnapshot                Int
  noteSnapshot                  String?
  unitPriceKopecks              Int
  baseSubtotalKopecks           Int                     @default(0)
  customDrawingStyle            CustomDrawingStyle?
  customDrawingSurchargeKopecks Int                     @default(0)
  customDesignKey               String?
  customImageUrl                String?
  customImageStoragePath        String?
  customImageReviewStatus       CustomImageReviewStatus @default(NOT_REQUIRED)
  customImageReviewComment      String?
  discountKopecks               Int                     @default(0)
  quantity                      Int
  subtotalKopecks               Int
  createdAt                     DateTime                @default(now())
  order                         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                       Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([priceListItemId])
  @@index([customImageReviewStatus])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerPaymentId String?
  amountKopecks     Int
  status            PaymentStatus   @default(PENDING)
  idempotencyKey    String          @unique
  confirmationUrl   String?
  rawWebhookPayload Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
}

model NotificationLog {
  id                  String    @id @default(cuid())
  orderId             String
  type                String
  recipientTelegramId BigInt
  deduplicationKey    String    @unique
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([recipientTelegramId])
}
